{
  "name": "focusflow",
  "version": "4.0.2",
  "private": true,
  "description": "Strict study-only browser extension: a local LLM judges each page from its metadata.",
  "type": "module",
  "scripts": {
    "test": "node --test \"tests/unit/*.test.js\"",
    "test:e2e": "node --test --test-concurrency=1 \"tests/e2e/*.test.js\"",
    "lint": "node scripts/check.mjs",
    "package": "node scripts/package.mjs"
  },
  "devDependencies": {
    "playwright": "1.56.1"
  },
  "engines": {
    "node": ">=20"
  }
}
